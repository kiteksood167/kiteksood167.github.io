---
layout: null
permalink: /search.json
sitemap: false
---
[
{%- for p in site.posts -%}
  {
    "title": {{ p.title | jsonify }},
    "url": {{ p.url | relative_url | jsonify }},
    "date": {{ p.date | date: "%-d %b %Y" | jsonify }},
    "category": {{ p.category | default: "Guides" | jsonify }},
    "tags": {{ p.tags | join: " " | jsonify }},
    "description": {{ p.description | default: p.excerpt | strip_html | strip_newlines | truncate: 180 | jsonify }},
    "thumb": {% if p.image %}{% capture t %}{% include thumb.html src=p.image %}{% endcapture %}{{ t | strip | jsonify }}{% else %}""{% endif %}
  }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
